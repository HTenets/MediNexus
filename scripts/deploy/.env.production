# MediNexus 生产环境配置

# 数据库配置
POSTGRES_DB=medinexus
POSTGRES_USER=medinexus
POSTGRES_PASSWORD=your_secure_postgres_password_here

# 后端配置
MEDINEXUS_DATABASE_URL=postgresql+asyncpg://medinexus:your_secure_postgres_password_here@postgres:5432/medinexus
MEDINEXUS_REDIS_URL=redis://redis:6379/0
MEDINEXUS_QDRANT_URL=http://qdrant:6333
MEDINEXUS_JWT_SECRET=your_very_secure_jwt_secret_here_must_be_long_and_random
MEDINEXUS_DEMO_MODE=true
MEDINEXUS_ALLOWED_ORIGINS=http://47.80.10.180,https://47.80.10.180

# LLM配置（云端 API Key 演示用，按实际 provider 填写）
# provider 可选: openai / deepseek / moonshot / anthropic / ollama
MEDINEXUS_LLM_PROVIDER=deepseek
# 对应 provider 的 API Key（必填，否则自动降级到规则引擎）
MEDINEXUS_LLM_API_KEY=your_llm_api_key_here
# 模型名（留空则使用各 provider 默认值）
MEDINEXUS_LLM_MODEL=deepseek-chat
# OpenAI 兼容端点（deepseek/moonshot 等需要；openai/anthropic 留空用默认）
MEDINEXUS_LLM_BASE_URL=https://api.deepseek.com/v1
MEDINEXUS_OLLAMA_BASE_URL=http://localhost:11434
MEDINEXUS_OLLAMA_MODEL=qwen2.5:14b

# 前端配置
NEXT_PUBLIC_API_URL=http://47.80.10.180