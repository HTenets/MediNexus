{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://medinexus-api.onrender.com/api/v1/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_WS_URL": "wss://medinexus-api.onrender.com"
  }
}
