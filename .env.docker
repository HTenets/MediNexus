POSTGRES_DB=medinexus
POSTGRES_USER=medinexus
POSTGRES_PASSWORD=your-strong-db-password-here

MEDINEXUS_DATABASE_URL=postgresql+asyncpg://medinexus:your-strong-db-password-here@postgres:5432/medinexus
MEDINEXUS_REDIS_URL=redis://redis:6379/0
MEDINEXUS_QDRANT_URL=http://qdrant:6333
MEDINEXUS_JWT_SECRET=your-very-long-and-secure-jwt-secret-here
MEDINEXUS_DEMO_MODE=false
MEDINEXUS_ALLOWED_ORIGINS=http://your-server-ip:80,http://your-domain.com

NEXT_PUBLIC_API_URL=http://localhost:80