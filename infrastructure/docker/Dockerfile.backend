FROM python:3.12-slim

WORKDIR /app

# Install dependencies.
# 1) Install the full dependency set declared in pyproject.toml.
# 2) Always re-assert the critical runtime deps (incl. qdrant-client),
#    so a partial / optional-dependency failure can NEVER ship an image
#    missing qdrant (which previously broke the knowledge import).
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e . || true
RUN pip install --no-cache-dir \
    fastapi "uvicorn[standard]" sqlalchemy asyncpg alembic pydantic pydantic-settings \
    python-jose[cryptography] passlib[bcrypt] httpx \
    langgraph langchain-core qdrant-client redis celery

# Copy backend source
COPY backend/ /app/

# Create a non-root user and switch to it
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
# Run migrations before serving when a database is configured
CMD ["sh", "-c", "if [ -n \"$MEDINEXUS_DATABASE_URL\" ]; then alembic upgrade head; fi && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
